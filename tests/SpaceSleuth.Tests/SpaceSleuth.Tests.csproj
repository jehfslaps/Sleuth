<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the ranking and labelling logic using the same source files as the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\SpaceSleuth\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\SpaceSleuth\Windows\History.cs" Link="Windows\History.cs" />
  </ItemGroup>

</Project>
