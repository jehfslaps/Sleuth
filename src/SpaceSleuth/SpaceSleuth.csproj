<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets .NET Framework 4.8, which ships inside every copy of Windows 11.
    That keeps SpaceSleuth.exe tiny (a few hundred KB) with nothing extra to install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>SpaceSleuth</AssemblyName>
    <RootNamespace>SpaceSleuth</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <Product>Space Sleuth</Product>
    <Description>Shows where your disk space went recently.</Description>
    <Copyright>jehfslaps</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
